{
  "name": "codex-scope-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Temporary live hook event history inspector",
  "license": "MIT",
  "type": "module",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.mjs",
    "test": "npm run test:unit && node scripts/desktop.mjs npx playwright test",
    "pretest": "npm run build",
    "test:unit": "node --test test/recording.test.mjs test/search.test.mjs test/transport.test.mjs test/resource-thresholds.test.mjs",
    "test:electron": "node scripts/desktop.mjs npx playwright test",
    "measure": "node scripts/measure.mjs",
    "measure:history": "node scripts/measure-history.mjs",
    "measure:navigation": "node scripts/measure-navigation.mjs",
    "test:collector": "node scripts/collector-smoke.mjs",
    "measure:transport": "node scripts/measure-transport.mjs",
    "validate:visual": "node scripts/validate-visual.mjs",
    "validate:resources": "npm run build && node scripts/desktop.mjs node scripts/validate-resources.mjs",
    "check:resources": "node scripts/check-resources.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.3.0"
  }
}
